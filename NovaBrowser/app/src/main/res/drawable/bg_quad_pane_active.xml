<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Substrate Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0D000000" />
        </shape>
    </item>
    <!-- Liquid Glass Surface with Active Highlight Rim -->
    <item
        android:bottom="1dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/surface_bright" />
            <stroke
                android:width="1.5dp"
                android:color="@color/horizon_primary" />
        </shape>
    </item>
</layer-list>
