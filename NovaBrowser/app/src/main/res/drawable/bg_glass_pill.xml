<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Substrate Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#0A000000" />
        </shape>
    </item>
    <!-- Liquid Glass Surface with Specular Rim Highlight -->
    <item
        android:bottom="1dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/glass_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/horizon_glass_border" />
        </shape>
    </item>
</layer-list>
