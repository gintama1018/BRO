<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_glass_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivSnifferIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_glass_pill_dark"
        android:padding="7dp"
        android:src="@drawable/ic_auto_awesome"
        app:tint="@color/accent_emerald" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSnifferName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="video_sample.mp4"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSnifferType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="VIDEO"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSnifferDownload"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_glass_pill_dark"
        android:paddingHorizontal="14dp"
        android:text="Download"
        android:textAllCaps="false"
        android:textColor="@color/text_on_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
