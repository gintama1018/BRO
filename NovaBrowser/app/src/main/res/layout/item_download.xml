<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_glass_card"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- File Icon Frame -->
    <FrameLayout
        android:id="@+id/layoutDownloadIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_glass_subtle">

        <ImageView
            android:id="@+id/ivDownloadIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="File Icon"
            android:src="@drawable/ic_file"
            app:tint="@color/risk_safe" />
    </FrameLayout>

    <!-- Content: Filename, Meta, Status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDownloadFilename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="downloaded_file.pdf"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDownloadMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="2.4 MB • Today, 3:45 PM"
                android:textColor="@color/text_tertiary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvDownloadStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_emerald"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="SAFE"
                android:textColor="@color/risk_safe_on_container"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <ImageButton
        android:id="@+id/btnShareDownload"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Share"
        android:padding="6dp"
        android:src="@drawable/ic_share"
        app:tint="@color/text_secondary" />

    <ImageButton
        android:id="@+id/btnDeleteDownload"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete"
        android:padding="6dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/text_secondary" />

</LinearLayout>
