<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_pill"
        android:backgroundTint="@color/border" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_badge_emerald"
            android:padding="6dp"
            android:src="@drawable/ic_security"
            app:tint="@color/accent_emerald" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTransparencyHost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="example.com"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTransparencyOrigin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Canonical Origin • Local Sandbox"
                android:textColor="@color/accent_emerald"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Transparency Description Card -->
    <TextView
        android:id="@+id/tvTransparencySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glass_pill"
        android:lineSpacingMultiplier="1.2"
        android:padding="12dp"
        android:text="Everything NovaBrowser knows or stores about this site is kept strictly in local, app-private storage. Zero telemetry or browsing data is ever transmitted off-device."
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <!-- Site Permissions Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="DEVICE PERMISSIONS"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTransparencyPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.2"
        android:text="• No hardware permissions requested"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- Local Data Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="LOCAL TELEMETRY &amp; CACHE"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTransparencyTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.2"
        android:text="• Storage: SQLite WAL Sandbox\n• Trackers Neutralized: 0 on active tab\n• External Transmission: 0 bytes"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClearSiteData"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Clear Site Data"
            android:textAllCaps="false"
            android:textColor="@color/risk_blocked"
            app:strokeColor="@color/risk_blocked" />

        <Button
            android:id="@+id/btnDoneTransparency"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_emerald"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
