<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="9dp">

    <!-- Suggestion Category Glyph (Search / History / Bookmark) -->
    <ImageView
        android:id="@+id/ivSuggestionIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="Suggestion Type"
        android:src="@drawable/ic_search"
        app:tint="@color/text_secondary" />

    <!-- Text Payload: Title & URL/Domain -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSuggestionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSuggestionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Insert Query into Omnibox Action Button -->
    <ImageView
        android:id="@+id/ivSuggestionInsert"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Insert text"
        android:focusable="true"
        android:padding="5dp"
        android:src="@drawable/ic_north_west"
        app:tint="@color/text_tertiary" />

</LinearLayout>
