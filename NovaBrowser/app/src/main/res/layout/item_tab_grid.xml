<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTab"
    android:layout_width="match_parent"
    android:layout_height="210dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_glass_card"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Card Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivTabIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Tab Icon"
            android:src="@drawable/ic_tabs"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/tvTabTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="GitHub: Where the world builds software" />

        <ImageButton
            android:id="@+id/btnCloseTab"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_tab"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Card Thumbnail / Preview Body -->
    <FrameLayout
        android:id="@+id/layoutTabPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tab_thumbnail_fallback">

        <!-- Captured Live Thumbnail -->
        <ImageView
            android:id="@+id/ivTabThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- High-Fidelity Fallback Preview -->
        <LinearLayout
            android:id="@+id/layoutThumbnailFallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvDomainMonogram"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_pill_dark"
                android:gravity="center"
                android:textColor="@color/accent_emerald"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="GH" />

            <TextView
                android:id="@+id/tvDomainBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_on_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="github.com" />

            <TextView
                android:id="@+id/tvSecurityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SECURE • SANDBOXED"
                android:textColor="@color/risk_safe"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Card Footer Status -->
    <LinearLayout
        android:id="@+id/layoutActiveIndicator"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:visibility="invisible"
        tools:visibility="visible">

        <View
            android:id="@+id/viewActiveDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_glass_pill"
            android:backgroundTint="@color/accent_emerald" />

        <TextView
            android:id="@+id/tvActiveText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="ACTIVE TAB"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
