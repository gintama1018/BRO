<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_glass_pill"
        android:backgroundTint="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_palette"
            app:tint="@color/accent_emerald" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Start Canvas Wallpaper"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Select a celestial theme or pick a custom photo"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <!-- Presets Grid / Column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- Deep Space Obsidian -->
        <LinearLayout
            android:id="@+id/cardPresetDeepSpace"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_dot_emerald"
                android:backgroundTint="#0F1117" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Deep Space Obsidian (Classic)"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cosmic Aurora -->
        <LinearLayout
            android:id="@+id/cardPresetAurora"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_dot_emerald"
                android:backgroundTint="#05668D" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Cosmic Aurora (Emerald Cyan)"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cyberpunk Neon -->
        <LinearLayout
            android:id="@+id/cardPresetCyberpunk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_dot_emerald"
                android:backgroundTint="#818CF8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Cyberpunk Neon (Violet Glow)"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Midnight Sapphire -->
        <LinearLayout
            android:id="@+id/cardPresetSapphire"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_dot_emerald"
                android:backgroundTint="#1C2541" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Midnight Sapphire (Deep Blue)"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnPickGalleryPhoto"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_glass_pill_dark"
        android:text="🖼️  Choose Custom Photo from Gallery"
        android:textAllCaps="false"
        android:textColor="@color/text_on_primary"
        android:textSize="13.5sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
